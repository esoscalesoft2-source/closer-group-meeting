# Copy this file to .env. Razorpay keys and email can also be set on /admin (those win).
# Razorpay keys — optional fallback. Easier: /admin → Payments. Razorpay Dashboard → Account & Settings → API Keys.
# Use rzp_test_… keys while testing; switch to rzp_live_… keys to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Starting registration fee in rupees, used until one is saved on /admin.
# The server decides the amount, never the browser.
REGISTRATION_FEE=999

# Shown on the Razorpay checkout popup.
BUSINESS_NAME=ESO Closer

PORT=3002

# Admin page (/admin) login. The fee set there overrides REGISTRATION_FEE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Email (SMTP) — optional fallback. Easier: set it on /admin → Email settings (that wins over these).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
# SMTP_PASS=a Google "App password" (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Encrypts the SMTP password and Razorpay secret saved on /admin (any long random string).
APP_SECRET=
